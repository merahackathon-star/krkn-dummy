# This is an example secrets file for local testing with `act`.
# Do NOT commit your actual `.secrets` file to version control!
# Copy this file to `.secrets` and fill in your actual keys.

# Required for the Gemini Docs Updater workflow
GEMINI_API_KEY=your_actual_gemini_api_key_here

# Required for creating PRs locally via act (using the peter-evans action)
# You need a classic Personal Access Token with 'repo' scope.
GITHUB_TOKEN=your_actual_github_personal_access_token_here
